{
  "manifest_version": 3,
  "name": "Foot Size — is my size in this list?",
  "version": "1.0.0",
  "description": "Set your foot length once. Then select any size list on any shop and find out whether your size is really in it.",
  "homepage_url": "https://github.com/ntx4891-dot/foot-size",
  "icons": {
    "16": "icons/16.png",
    "48": "icons/48.png",
    "128": "icons/128.png"
  },
  "action": {
    "default_popup": "popup.html",
    "default_title": "Foot Size"
  },
  "background": {
    "service_worker": "background.js",
    "type": "module"
  },
  "permissions": ["storage", "contextMenus", "notifications"]
}
